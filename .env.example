# Global settings. Per-account credentials live in config/accounts.yaml.
# Keeping a dummy .env is optional; the loader will merge env vars with the YAML.

LOG_LEVEL=INFO
CONFIG_PATH=/app/config/accounts.yaml

# Path (inside the container) of the shared SQLite trade registry.
# Persist the parent directory to a volume so the companion "closer" bot
# can read the same file.
TRADE_DB_PATH=/app/state/trades.sqlite3

# Optional: override default polling cadence (seconds between strategy ticks)
TICK_INTERVAL_SECONDS=20
